# Copy to .env and adjust. Never commit .env.
# Hugging Face cache (models are several GB) — put it on a drive with space.
HF_HOME=D:/AI/hf_cache
# Where activations / arXiv category cache are written (default: ./artifacts)
MATHGEOM_ARTIFACTS=D:/AI/geometry-math-llms/artifacts
# Optional: HF token for uploads (huggingface-cli login also works)
# HF_TOKEN=
